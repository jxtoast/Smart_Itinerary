# Gateway (services/gateway) — the only service clients talk to directly.
# Auth-related names come from packages/shared/.env.example (adapters/jwt.ts);
# the upstream URLs are gateway-specific (route table in src/upstreams.ts).

SERVICE_NAME=gateway
PORT=8080
NODE_ENV=development
LOG_LEVEL=info

# --- Auth tokens (packages/shared/src/adapters/jwt.ts) ---
TOKEN_VERIFY_MODE=dev                 # dev | cognito — dev enables POST /api/auth/dev-token
JWT_DEV_SECRET=dev-only-secret        # dev mode only
# cognito mode (production; gateway exits at boot if these are missing):
# COGNITO_ISSUER=https://cognito-idp.<region>.amazonaws.com/<userPoolId>
# COGNITO_CLIENT_ID=<appClientId>

# --- Upstream service URLs (src/upstreams.ts route table) ---
# Unset URL = that area reports 502 "<service> is down" (the gateway stays up).
# docker-compose sets these to service hostnames; bare-metal runs use localhost.
AUTH_SERVICE_URL=http://localhost:8081
ITINERARY_SERVICE_URL=http://localhost:8082
GEMINI_SERVICE_URL=http://localhost:8083
TOOLS_SERVICE_URL=http://localhost:8084

# --- Proxy behaviour ---
# UPSTREAM_TIMEOUT_MS=60000            # per-request upstream call ceiling

# --- Rate limiting (applies to /api/* only, never /healthz) ---
# RATE_LIMIT_WINDOW_MS=900000          # 15 minutes
# RATE_LIMIT_MAX=300                   # requests per window per IP
