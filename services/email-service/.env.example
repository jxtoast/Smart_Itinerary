# email-service (diagram: "Email Service", port 8085)
# AMQP-only — no DATABASE_URL: all state lives in RabbitMQ queues. Subset of
# packages/shared/.env.example plus this service's own vars. When running the
# service bare on your machine use the published ports
# (rabbitmq → localhost:5672, mailpit SMTP → localhost:1025).

SERVICE_NAME=email-service
PORT=8085

# RabbitMQ — consumes email.events + reminders.due, and parks scheduled
# reminders in reminders.waiting (TTL + dead-letter, see @smart/shared's
# broker adapter)
AMQP_URL=amqp://guest:guest@localhost:5672

# SMTP (adapters/mailer.ts) — Mailpit locally, SES SMTP interface on AWS
SMTP_HOST=localhost
SMTP_PORT=1025
# SMTP_USER=            # only when the relay requires auth
# SMTP_PASS=
MAIL_FROM=Smart Itinerary <no-reply@smart-itinerary.local>
MAILER_DRY_RUN=false   # true = log instead of sending (no SMTP needed)

# itinerary.created / reminders.due carry only userId — not the owner's
# address (contract gap flagged in docs/TASKS.md). Until the shared event
# grows an ownerEmail field, confirmation + reminder mails go to this
# fallback address; Mailpit catches it regardless of domain.
OWNER_EMAIL_FALLBACK=owner@smart-itinerary.local

# Base URL for the share / group-invite links inside emails (the web app's)
WEB_APP_URL=http://localhost:3000

LOG_LEVEL=info
