# auth-service (port 8081) — diagram: "Authentication Service (User Profile)".
# Variable names match packages/shared/.env.example. Locally they point at the
# docker-compose stack; on AWS the same vars point at RDS / Cognito — the
# adapters swap by env var only, no code changes.

SERVICE_NAME=auth-service
PORT=8081
NODE_ENV=development

# Postgres (adapters/db.ts) — this service's own database (database-per-service).
# DDL: db/init/auth-service.sql (users, users_demographics).
# Host-run: auth-db is published on localhost:5433. Inside compose: auth-db:5432.
DATABASE_URL=postgres://smart:smart@localhost:5433/smart_auth

# Auth tokens (adapters/jwt.ts)
#   dev     — accepts locally-signed HS256 dev tokens (mock auth / Cypress).
#   cognito — verifies the Cognito user pool JWKS (created by infra/cognito;
#             see its RUNBOOK.md for COGNITO_ISSUER / COGNITO_CLIENT_ID).
TOKEN_VERIFY_MODE=dev
JWT_DEV_SECRET=dev-only-secret

# Logging (adapters/http.ts)
LOG_LEVEL=info
