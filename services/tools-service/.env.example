# tools-service (diagram: "Tools Service — Export PDF, Sharing", port 8084)
# Subset of packages/shared/.env.example — only the vars this service reads.
# Inside docker-compose the hosts are tools-db / rabbitmq / minio /
# itinerary-service; running bare on your machine use the published ports
# (tools-db → localhost:5436, rabbitmq → localhost:5672, minio → :9000,
# itinerary-service → localhost:8082).

SERVICE_NAME=tools-service
PORT=8084

# Tools database (DDL + demo seed: db/init/tools-service.sql)
DATABASE_URL=postgres://smart:smart@localhost:5436/smart_tools

# RabbitMQ — group.invited and itinerary.shared are published here (best-effort)
AMQP_URL=amqp://guest:guest@localhost:5672

# Where PDF exports are stored (MinIO locally, real S3 on AWS — see
# packages/shared/src/adapters/storage.ts; bucket is created by minio-init)
S3_ENDPOINT=http://localhost:9000     # unset on AWS
S3_REGION=ap-southeast-1
S3_BUCKET=si-files
S3_ACCESS_KEY_ID=smart
S3_SECRET_ACCESS_KEY=smart-local-dev
S3_FORCE_PATH_STYLE=true              # false on AWS
S3_PRESIGN_TTL_SECONDS=3600           # also used for the expiresAt field

# Internal call to fetch itinerary aggregates for PDF export / share views
ITINERARY_SERVICE_URL=http://localhost:8082

# Public origin of the web app — shareUrl is `${WEB_PUBLIC_URL}/shared/<token>`
WEB_PUBLIC_URL=http://localhost:3000

# JWT verification (dev mode verifies locally-signed mock tokens — see
# packages/shared/src/adapters/jwt.ts)
TOKEN_VERIFY_MODE=dev
JWT_DEV_SECRET=dev-only-secret
# TOKEN_VERIFY_MODE=cognito also needs:
# COGNITO_ISSUER=https://cognito-idp.<region>.amazonaws.com/<userPoolId>
# COGNITO_CLIENT_ID=<appClientId>

LOG_LEVEL=info
