# gemini-service (diagram: "Gemini Service (Hotel Service)", port 8083)
# Subset of packages/shared/.env.example plus this service's own vars.
# Inside docker-compose the host is gemini-db; when running the service bare
# on your machine use the published port (gemini-db → localhost:5435).

SERVICE_NAME=gemini-service
PORT=8083

# Gemini database (DDL + demo seed: db/init/gemini-service.sql) — audit rows
# and the reference data (countries / travel types)
DATABASE_URL=postgres://smart:smart@localhost:5435/smart_gemini

# --- Google Gemini (AI generation) — SERVER-SIDE ONLY, never NEXT_PUBLIC_ ---
# Without a key the service still boots: /healthz and reference data work,
# generation endpoints answer 503. Same key value the web app used to carry
# as NEXT_PUBLIC_GEMINI_API_KEY.
GEMINI_API_KEY=
# Optional: pin the model if Google deprecates the default
# GEMINI_MODEL=gemini-2.0-flash

# --- Amadeus (flight search) — SERVER-SIDE ONLY -----------------------------
# Without a key, flight endpoints answer 503 and /plan simply omits flights.
AMADEUS_API_KEY=
# Test host (same value the monolith carried); swap for https://api.amadeus.com/v2 in prod
AMADEUS_FLIGHTS_API_BASE_URL=https://test.api.amadeus.com/v2

# JWT verification (dev mode verifies locally-signed mock tokens — see
# packages/shared/src/adapters/jwt.ts)
TOKEN_VERIFY_MODE=dev
JWT_DEV_SECRET=dev-only-secret
# TOKEN_VERIFY_MODE=cognito also needs:
# COGNITO_ISSUER=https://cognito-idp.<region>.amazonaws.com/<userPoolId>
# COGNITO_CLIENT_ID=<appClientId>

LOG_LEVEL=info
