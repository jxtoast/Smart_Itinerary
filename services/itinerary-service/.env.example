# itinerary-service (diagram: "Itinerary Service", port 8082)
# Subset of packages/shared/.env.example — only the vars this service reads.
# Inside docker-compose the hosts are itinerary-db / rabbitmq; when running
# the service bare on your machine use the published ports
# (itinerary-db → localhost:5434, rabbitmq → localhost:5672).

SERVICE_NAME=itinerary-service
PORT=8082

# Itinerary database (DDL + demo seed: db/init/itinerary-service.sql)
DATABASE_URL=postgres://smart:smart@localhost:5434/smart_itinerary

# RabbitMQ — itinerary.created is published here after every successful save
AMQP_URL=amqp://guest:guest@localhost:5672

# JWT verification (dev mode verifies locally-signed mock tokens — see
# packages/shared/src/adapters/jwt.ts)
TOKEN_VERIFY_MODE=dev
JWT_DEV_SECRET=dev-only-secret
# TOKEN_VERIFY_MODE=cognito also needs:
# COGNITO_ISSUER=https://cognito-idp.<region>.amazonaws.com/<userPoolId>
# COGNITO_CLIENT_ID=<appClientId>

LOG_LEVEL=info
