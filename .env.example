# Smart Itinerary — root environment reference (docker-compose).
#
# Copy to .env (gitignored — never commit a real one) and fill in what you
# have. The stack is fully runnable at $0 without any of the third-party
# keys: gemini-service boots and answers its reference/health endpoints,
# while generation/flights endpoints degrade to honest 503s until keys are
# provided. This file lists only the variables docker-compose.yml interpolates
# from your shell; per-service variables (ports, DATABASE_URL, AMQP_URL, …)
# have working defaults inside compose. See apps/web/.env.example for the web
# app and services/*/.env.example for running a service bare-metal.

# --- Google Gemini (gemini-service AI generation) — server-side only -------
# Free-tier keys work; get one at https://aistudio.google.com/apikey.
# Without it: /generate-itinerary, /generate-weather and /plan answer 503.
GEMINI_API_KEY=
# Optional: pin the model (default gemini-3.6-flash; see
# services/gemini-service/.env.example)
# GEMINI_MODEL=gemini-3.6-flash

# --- Amadeus (gemini-service flight search) — server-side only -------------
# Without it flight endpoints answer 503 and /plan omits flightDetails.
AMADEUS_API_KEY=
# Test host by default; swap for https://api.amadeus.com/v2 in production.
AMADEUS_FLIGHTS_API_BASE_URL=https://test.api.amadeus.com/v2

# --- Everything else has working defaults in docker-compose.yml ------------
# LOG_LEVEL, TOKEN_VERIFY_MODE (= dev; see packages/shared/.env.example for
# the Cognito mode variables), JWT_DEV_SECRET, OWNER_EMAIL_FALLBACK,
# WEB_PUBLIC_URL / WEB_APP_URL, SMTP_* and the S3_* MinIO credentials are
# hardcoded per-service block in docker-compose.yml — edit the compose file
# (or add your own ${VAR:-default} interpolations) to change them. Each
# service also documents its full variable set in services/*/.env.example.
