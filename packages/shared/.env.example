# @smart/shared — adapter environment variables (reference).
# Each service copies the subset it uses into its own .env / environment.
# Locally these point at docker-compose services; on AWS the same vars point
# at RDS / Amazon MQ / S3 / SES — no code changes.

# --- Postgres (adapters/db.ts) — one database per service
# auth-service:        postgres://smart:smart@auth-db:5432/smart_auth
# itinerary-service:   postgres://smart:smart@itinerary-db:5432/smart_itinerary
# gemini-service:      postgres://smart:smart@gemini-db:5432/smart_gemini
# tools-service:       postgres://smart:smart@tools-db:5432/smart_tools
DATABASE_URL=postgres://smart:smart@localhost:5433/smart_auth

# --- RabbitMQ (adapters/broker.ts)
AMQP_URL=amqp://guest:guest@localhost:5672

# --- Object storage (adapters/storage.ts) — MinIO locally, real S3 on AWS
S3_ENDPOINT=http://localhost:9000     # unset on AWS
S3_REGION=ap-southeast-1
S3_BUCKET=si-files
S3_ACCESS_KEY_ID=smart
S3_SECRET_ACCESS_KEY=smart-local-dev
S3_FORCE_PATH_STYLE=true              # false on AWS
S3_PRESIGN_TTL_SECONDS=3600

# --- Email over SMTP (adapters/mailer.ts) — Mailpit locally, SES SMTP on AWS
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=Smart Itinerary <no-reply@smart-itinerary.local>
MAILER_DRY_RUN=false

# --- Auth tokens (adapters/jwt.ts)
TOKEN_VERIFY_MODE=dev                 # dev | cognito
JWT_DEV_SECRET=dev-only-secret        # dev mode only
# cognito mode:
# COGNITO_ISSUER=https://cognito-idp.<region>.amazonaws.com/<userPoolId>
# COGNITO_CLIENT_ID=<appClientId>

# --- Logging (adapters/http.ts)
LOG_LEVEL=info
