# apps/web — environment reference. Copy to .env.local (gitignored) and fill
# in what you need. None of these are secrets except the legacy Supabase keys
# (public anon keys by design, and both go away at the T3.4 cleanup).

# --- Gateway connection -------------------------------------------------
# The next.config.ts rewrite forwards same-origin /api/* calls to the gateway.
# Bare-metal dev points it at localhost:8080; docker-compose would use
# http://gateway:8080.
API_GATEWAY_URL=http://localhost:8080

# Browser base URL for @smart/api-client. Leave unset to keep calls
# same-origin under the rewrite (the supported setup); an absolute URL is
# only for calling the gateway from another origin.
# NEXT_PUBLIC_API_URL=

# --- Mock auth (Cypress / offline development) ---------------------------
# true → AuthContext returns the canned "Test User" without any network or
# Cognito involvement; the sign-in pages short-circuit home. This is the mode
# the Cypress specs and CI run in.
NEXT_PUBLIC_ENABLE_MOCK_AUTH=false

# --- Cognito sign-in (infra/cognito, see its RUNBOOK.md) ------------------
# Server-side only — read by app/auth/* route handlers; never NEXT_PUBLIC_.
# Both values come from `terraform apply` outputs in infra/cognito.
# COGNITO_HOSTED_UI_DOMAIN=https://<prefix>.auth.<region>.amazoncognito.com
# COGNITO_CLIENT_ID=<app client id>

# --- Legacy Supabase (monolith paths; removed at T3.4 cleanup) ------------
# Prerendered legacy pages fail the build without these set — placeholders
# are enough for typecheck/build.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
