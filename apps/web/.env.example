# apps/web — environment reference. Copy to .env.local (gitignored) and fill
# in what you need. Nothing here is a secret: all AI/provider keys live in the
# backend services (see services/gemini-service/.env.example), and the browser
# bundle only ever talks same-origin /api/*.

# --- Gateway connection ---------------------------------------------------
# The next.config.ts rewrite forwards same-origin /api/* calls to the gateway.
# Bare-metal dev points it at localhost:8080; docker-compose uses
# http://gateway:8080.
API_GATEWAY_URL=http://localhost:8080

# Browser base URL for @smart/api-client. Leave unset to keep calls
# same-origin under the rewrite (the supported setup); an absolute URL is
# only for calling the gateway from another origin.
# NEXT_PUBLIC_API_URL=

# --- Mock auth (Cypress / offline development) -----------------------------
# true → getApiClient() swaps in the canned in-memory client (the "Test User"
# session, mock itineraries/groups) without any network or Cognito
# involvement; sign-in short-circuits home. This is the mode the Cypress
# specs and CI run in.
NEXT_PUBLIC_ENABLE_MOCK_AUTH=false

# --- Cognito sign-in (infra/terraform/modules/cognito, see its RUNBOOK.md) --------------------
# Server-side only — read by app/auth/* route handlers; never NEXT_PUBLIC_.
# Unset (with NEXT_PUBLIC_ENABLE_MOCK_AUTH=false) the pool-less dev flow
# signs the visitor in with a shared dev token instead of Cognito.
# COGNITO_HOSTED_UI_DOMAIN=https://<prefix>.auth.<region>.amazoncognito.com
# COGNITO_CLIENT_ID=<app client id>
